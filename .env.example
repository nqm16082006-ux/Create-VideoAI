# ==========================================
# CẤU HÌNH API CHO HỆ THỐNG VIDEO AI
# (Mặc định nếu để trống, tool vẫn chạy 100% MIỄN PHÍ)
# ==========================================

# 1. LLM API (Tùy chọn - Dùng để tự động viết kịch bản từ 1 câu lệnh ngắn)
# Lựa chọn 1 trong các dịch vụ sau:
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# 2. Sinh ảnh AI cao cấp (Tùy chọn - Mặc định dùng Flux.1 miễn phí qua Pollinations)
FAL_KEY=

# 3. Giọng đọc mặc định
# Nam: vi-VN-NamMinhNeural
# Nữ: vi-VN-HoaiMyNeural
DEFAULT_VOICE=vi-VN-NamMinhNeural
